SELECT json_build_object(
    'event', 'MO.Confirmed',
    'mo_id', mp.id,
    'mo_name', mp.name,
    'product', json_build_object(
        'id', pp.id,
        'name', pt.name->>'en_US',
        'code', pp.default_code
    ),
    'qty_planned', mp.product_qty,
    'bom', json_build_object(
        'id', mb.id,
        'reference', mb.code
    ),
    'components', (
        SELECT COALESCE(json_agg(comp), '[]'::json)
        FROM (
            SELECT json_build_object(
                'id', comp_pp.id,
                'name', comp_pt.name->>'en_US',
                'code', comp_pp.default_code,
                'qty_required', sm.product_uom_qty,
                'uom', uom.name->>'en_US',
                'reserved_lots', (
                    SELECT COALESCE(json_agg(lot), '[]'::json)
                    FROM (
                        SELECT json_build_object(
                            'lot_id', sl.id,
                            'lot_name', sl.name,
                            'qty', sml.quantity
                        ) AS lot
                        FROM stock_move_line sml
                        JOIN stock_lot sl ON sl.id = sml.lot_id
                        WHERE sml.move_id = sm.id
                    ) lots
                )
            ) AS comp
            FROM stock_move sm
            JOIN product_product comp_pp ON comp_pp.id = sm.product_id
            JOIN product_template comp_pt ON comp_pt.id = comp_pp.product_tmpl_id
            JOIN uom_uom uom ON uom.id = sm.product_uom
            WHERE sm.raw_material_production_id = mp.id
              AND sm.state != 'cancel'
            ORDER BY sm.sequence
        ) components
    ),
    'workorders', (
        SELECT COALESCE(json_agg(wo), '[]'::json)
        FROM (
            SELECT json_build_object(
                'id', mw.id,
                'name', mw.name,
                'workcenter', wc.name,
                'duration_expected', mw.duration_expected,
                'state', mw.state
            ) AS wo
            FROM mrp_workorder mw
            JOIN mrp_workcenter wc ON wc.id = mw.workcenter_id
            WHERE mw.production_id = mp.id
            ORDER BY mw.sequence
        ) workorders
    )
) AS payload

FROM mrp_production mp
JOIN product_product pp ON pp.id = mp.product_id
JOIN product_template pt ON pt.id = pp.product_tmpl_id
LEFT JOIN mrp_bom mb ON mb.id = mp.bom_id

WHERE mp.id = {{this.mo_id}}